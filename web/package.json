    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.104.2",
    "chart.js": "^4.5.1",
    "pinia": "^4.0.3",
    "qrcode": "^1.5.4",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9",
    "vuetify": "^4.2.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "8.3.4",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
