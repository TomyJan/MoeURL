# Copy this file to .env, restrict it to the deployment account, and replace
# both secret values before running Docker Compose. Generate secrets with:
# openssl rand -hex 32
MOEURL_ENV=production
MOEURL_HTTP_HOST=127.0.0.1
MOEURL_HTTP_PORT=8080
# Enable only when a trusted proxy removes the client value and injects a
# validated two-letter country code using this header name.
MOEURL_ANALYTICS_COUNTRY_HEADER=
MOEURL_POSTGRES_PASSWORD=
MOEURL_SETUP_TOKEN=

# Used only with docker-compose.dev.yml for explicit local database access.
MOEURL_POSTGRES_HOST=127.0.0.1
MOEURL_POSTGRES_PORT=5432
