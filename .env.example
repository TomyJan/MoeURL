# Copy this file to .env, restrict it to the deployment account, and replace
# both secret values before running Docker Compose. Generate secrets with:
# openssl rand -hex 32
MOEURL_ENV=production
MOEURL_HTTP_HOST=127.0.0.1
MOEURL_HTTP_PORT=8080
# Enable only when a trusted proxy removes the client value and injects a
# validated two-letter country code using this header name.
MOEURL_ANALYTICS_COUNTRY_HEADER=
# Wrap the complete password value in single quotes so literal $VAR or ${VAR}
# text is preserved. Encode each $ as %24 in MOEURL_DATABASE_URL below.
MOEURL_POSTGRES_PASSWORD=
# Supply the complete connection URL. Percent-encode reserved password
# characters independently; the default trusted Compose network uses
# sslmode=disable as an accepted single-host deployment risk.
MOEURL_DATABASE_URL=
MOEURL_SETUP_TOKEN=

# Optional OIDC runtime. Configure both values before enabling any provider.
# PUBLIC_BASE_URL is the externally reachable HTTPS origin registered with the
# provider. Keep the encryption key outside database backups and generate it with:
# openssl rand -base64 32
MOEURL_PUBLIC_BASE_URL=
MOEURL_OIDC_ENCRYPTION_KEY=

# Used only with docker-compose.dev.yml for explicit local database access.
MOEURL_POSTGRES_HOST=127.0.0.1
MOEURL_POSTGRES_PORT=5432
